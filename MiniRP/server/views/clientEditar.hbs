<h1>Editar cliente</h1>

<div class="card form-card">
  <form method="POST" action="/update" onsubmit="return validarCliente()">

    <input type="hidden" name="taula" value="customers">
    <input type="hidden" name="id" value="{{client.id}}">

    <div class="form-group">
      <label>Nombre</label>
      <input id="name" name="name" type="text" value="{{client.name}}">
      <div class="form-error">El nombre es demasiado corto</div>
    </div>

    <div class="form-group">
      <label>Email</label>
      <input id="email" name="email" type="email" value="{{client.email}}">
      <div class="form-error">Email inválido</div>
    </div>

    <div class="form-group">
      <label>Teléfono</label>
      <input id="phone" name="phone" type="text" value="{{client.phone}}">
      <div class="form-error">Teléfono inválido</div>
    </div>

    <button class="btn">Guardar cambios</button>
  </form>
</div>

<div class="delete-zone">
  <form method="POST" action="/delete">
    <input type="hidden" name="taula" value="customers">
    <input type="hidden" name="id" value="{{client.id}}">
    <button class="btn-danger">Eliminar cliente</button>
  </form>
</div>
