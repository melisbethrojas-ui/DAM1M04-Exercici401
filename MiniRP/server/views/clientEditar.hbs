<section>
  <h2>Editar client</h2>

  <form id="form-client" method="POST" action="/update">
    <input type="hidden" name="taula" value="clients">
    <input type="hidden" name="id" value="{{client.id}}">

    <div class="form-group" data-field="name">
      <label>Nom *</label>
      <input type="text" name="name" value="{{client.name}}">
      <div class="form-error"></div>
    </div>

    <div class="form-group" data-field="email">
      <label>Email *</label>
      <input type="email" name="email" value="{{client.email}}">
      <div class="form-error"></div>
    </div>

    <div class="form-group" data-field="phone">
      <label>Telèfon *</label>
      <input type="text" name="phone" value="{{client.phone}}">
      <div class="form-error"></div>
    </div>

    <button class="btn">Guardar</button>
  </form>

  <form method="POST" action="/delete" style="margin-top:20px;">
    <input type="hidden" name="taula" value="clients">
    <input type="hidden" name="id" value="{{client.id}}">
    <button class="btn btn-danger">Eliminar client</button>
  </form>

  <script src="/js/clients-form.js"></script>
</section>
