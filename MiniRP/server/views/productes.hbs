{{> header}}
{{> menu}}

<div class="page-container">

<h1>Gestión de productos</h1>

<!-- BUSCADOR + TOGGLE -->
<div class="card">
  <form method="GET" action="/productes" class="search-bar">
    
    <input type="text" name="cerca" placeholder="Buscar productos..." value="{{cerca}}">

    <!-- 🔥 ID CORREGIDO -->
    <label class="toggle">
      <input type="checkbox" id="toggleStockColors">
      <span>Colores de stock</span>
    </label>

    <button class="btn">Buscar</button>
  </form>
</div>

<!-- TABLA -->
<div class="card">
  <table class="table">
    <thead>
      <tr>
        <th>Nombre</th>
        <th>Categoría</th>
        <th>Precio</th>
        <th>Stock</th>
        <th>Activo</th>
        <th>Acciones</th>
      </tr>
    </thead>

    <tbody>
      {{#each productes}}
      <tr>

        <td>{{name}}</td>
        <td>{{category}}</td>
        <td>{{price}} €</td>

        <!-- 🔥 IMPORTANTE -->
        <td class="stock-value">
          {{stock}}
        </td>

        <td>{{#if active}}Sí{{else}}No{{/if}}</td>

        <td class="table-actions">
          <a class="btn-secondary" href="/producteEditar?id={{id}}">Editar</a>
        </td>

      </tr>
      {{/each}}
    </tbody>
  </table>
</div>

<a class="btn" href="/producteAfegir" style="margin-top:20px; display:inline-block;">
  Agregar producto
</a>

</div>

{{> footer}}