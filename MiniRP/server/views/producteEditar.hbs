<section>
  <h2>Editar producte</h2>

  <form id="form-producte" method="POST" action="/update">
    <input type="hidden" name="taula" value="productes">
    <input type="hidden" name="id" value="{{producte.id}}">

    <div class="form-group" data-field="name">
      <label>Nom *</label>
      <input type="text" name="name" value="{{producte.name}}">
      <div class="form-error"></div>
    </div>

    <div class="form-group" data-field="category">
      <label>Categoria *</label>
      <input type="text" name="category" value="{{producte.category}}">
      <div class="form-error"></div>
    </div>

    <div class="form-group" data-field="price">
      <label>Preu *</label>
      <input type="number" step="0.01" name="price" value="{{producte.price}}">
      <div class="form-error"></div>
    </div>

    <div class="form-group" data-field="stock">
      <label>Stock *</label>
      <input type="number" name="stock" value="{{producte.stock}}">
      <div class="form-error"></div>
    </div>

    <div class="form-group" data-field="active">
      <label>Actiu</label>
      <select name="active">
        <option value="1" {{#if producte.active}}selected{{/if}}>Sí</option>
        <option value="0" {{#unless producte.active}}selected{{/unless}}>No</option>
      </select>
      <div class="form-error"></div>
    </div>

    <button class="btn">Guardar</button>
  </form>

  <form method="POST" action="/delete" style="margin-top:20px;">
    <input type="hidden" name="taula" value="productes">
    <input type="hidden" name="id" value="{{producte.id}}">
    <button class="btn btn-danger">Eliminar producte</button>
  </form>

  <script src="/js/productes-form.js"></script>
</section>
