<h1>Editar producto</h1>

<div class="card form-card">
  <form method="POST" action="/update" onsubmit="return validarProducto()">

    <input type="hidden" name="taula" value="products">
    <input type="hidden" name="id" value="{{producte.id}}">

    <div class="form-group">
      <label>Nombre</label>
      <input id="name" name="name" type="text" value="{{producte.name}}">
      <div class="form-error">El nombre es demasiado corto</div>
    </div>

    <div class="form-group">
      <label>Categoría</label>
      <input id="category" name="category" type="text" value="{{producte.category}}">
    </div>

    <div class="form-group">
      <label>Precio</label>
      <input id="price" name="price" type="number" step="0.01" value="{{producte.price}}">
      <div class="form-error">Precio inválido</div>
    </div>

    <div class="form-group">
      <label>Stock</label>
      <input id="stock" name="stock" type="number" value="{{producte.stock}}">
      <div class="form-error">Stock inválido</div>
    </div>

    <div class="form-group">
      <label>Activo</label>
      <select name="active">
        <option value="1" {{#if producte.active}}selected{{/if}}>Sí</option>
        <option value="0" {{#unless producte.active}}selected{{/unless}}>No</option>
      </select>
    </div>

    <button class="btn">Guardar cambios</button>
  </form>
</div>

<div class="delete-zone">
  <form method="POST" action="/delete">
    <input type="hidden" name="taula" value="products">
    <input type="hidden" name="id" value="{{producte.id}}">
    <button class="btn-danger">Eliminar producto</button>
  </form>
</div>
