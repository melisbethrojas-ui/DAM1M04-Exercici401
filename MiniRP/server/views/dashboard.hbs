<section>
  <h2>Dashboard</h2>

  <div class="tabs">
    <button class="tab-btn active" data-tab="kpi">KPI</button>
    <button class="tab-btn" data-tab="llistats">Llistats</button>
  </div>

  {{!-- TAB KPI --}}
  <div class="tab-content" id="tab-kpi">
    <div class="toolbar">
      <label>
        <input type="checkbox" id="toggle-kpi-compacte">
        Tauler compacte
      </label>
    </div>

    <div class="kpi-grid" data-mode="complet">
      <div class="card">
        <h3>Vendes d'avui</h3>
        <p>{{kpiToday.salesCount}} vendes</p>
        <p>{{kpiToday.total}} €</p>
      </div>

      <div class="card">
        <h3>Vendes del mes</h3>
        <p>{{kpiMonth.salesCount}} vendes</p>
        <p>{{kpiMonth.total}} €</p>
      </div>

      <div class="card">
        <h3>Comandes</h3>
        <p>Avui: {{kpiToday.orders}}</p>
        <p>Mes: {{kpiMonth.orders}}</p>
      </div>

      <div class="card">
        <h3>Stock baix</h3>
        <p>{{lowStockCount}} productes</p>
      </div>
    </div>
  </div>

  {{!-- TAB LLISTATS --}}
  <div class="tab-content hidden" id="tab-llistats">
    <div class="toolbar">
      <label>
        <input type="checkbox" id="toggle-stock-colors-dashboard">
        Codi de colors stock
      </label>
    </div>

    <div class="card">
      <h3>Últimes 5 vendes</h3>
      <table class="table">
        <thead>
          <tr>
            <th>Data</th>
            <th>Client</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          {{#each lastSales}}
          <tr>
            <td>{{this.date}}</td>
            <td>{{this.customer_name}}</td>
            <td>{{this.total}} €</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <div class="card">
      <h3>Top 5 productes més venuts</h3>
      <table class="table stock-color-table" data-color-enabled="false">
        <thead>
          <tr>
            <th>Producte</th>
            <th>Unitats</th>
            <th>Stock</th>
          </tr>
        </thead>
        <tbody>
          {{#each topProducts}}
          <tr data-stock="{{this.stock}}">
            <td>{{this.name}}</td>
            <td>{{this.qty_sold}}</td>
            <td class="stock-cell">{{this.stock}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</section>
