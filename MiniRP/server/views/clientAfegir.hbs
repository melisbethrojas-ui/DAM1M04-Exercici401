{{> header}}
{{> menu}}

<main class="container">
  <div class="page-container">
    <h1>Agregar cliente</h1>

    <div class="card form-card">
      <form id="formCliente" method="POST" action="/create" onsubmit="return validarCliente()">
        
        <input type="hidden" name="taula" value="customers">

        <div class="form-group" id="group-name">
          <label>Nombre</label>
          <input id="name" name="name" type="text" placeholder="Ej. Juan Pérez">
          <div class="form-error">Nombre demasiado corto</div>
        </div>

        <div class="form-group" id="group-email">
          <label>Email</label>
          <input id="email" name="email" type="email" placeholder="juan@correo.com">
          <div class="form-error">Email inválido</div>
        </div>

        <div class="form-group" id="group-phone">
          <label>Teléfono</label>
          <input id="phone" name="phone" type="text" placeholder="600000000">
          <div class="form-error">Teléfono demasiado corto</div>
        </div>

        <div style="margin-top: 20px;">
          <button type="submit" class="btn">Guardar Cliente</button>
          <a href="/clients" class="btn-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
</main>

<script>
function validarCliente() {
  let esValido = true;
  const name = document.getElementById('name');
  const groupName = document.getElementById('group-name');
  if (name.value.trim().length < 3) {
    groupName.classList.add('error');
    esValido = false;
  } else {
    groupName.classList.remove('error');
  }
  return esValido;
}
</script>

{{> footer}}