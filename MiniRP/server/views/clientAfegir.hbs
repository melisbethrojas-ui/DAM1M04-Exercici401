<h1>Agregar cliente</h1>

<div class="card form-card">
  <form method="POST" action="/create" onsubmit="return validarCliente()">

    <input type="hidden" name="taula" value="customers">

    <div class="form-group">
      <label>Nombre</label>
      <input id="name" name="name" type="text">
      <div class="form-error">El nombre es demasiado corto</div>
    </div>

    <div class="form-group">
      <label>Email</label>
      <input id="email" name="email" type="email">
      <div class="form-error">Email inválido</div>
    </div>

    <div class="form-group">
      <label>Teléfono</label>
      <input id="phone" name="phone" type="text">
      <div class="form-error">Teléfono inválido</div>
    </div>

    <button class="btn">Agregar</button>
  </form>
</div>
