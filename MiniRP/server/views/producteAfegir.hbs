{{> header}}
{{> menu}}

<main class="container">
  <div class="page-container">
    <h1>Agregar producto</h1>

    <div class="card form-card">
      <form id="formProducto" method="POST" action="/create" onsubmit="return validarProducto()">
        
        <input type="hidden" name="taula" value="products">

        <div class="form-group" id="group-name">
          <label>Nombre</label>
          <input id="name" name="name" type="text" placeholder="Ej. Martillo">
          <div class="form-error">Nombre demasiado corto</div>
        </div>

        <div class="form-group" id="group-category">
          <label>Categoría</label>
          <input id="category" name="category" type="text">
        </div>

        <div class="form-group" id="group-price">
          <label>Precio (€)</label>
          <input id="price" name="price" type="number" step="0.01">
          <div class="form-error">Precio inválido</div>
        </div>

        <div class="form-group" id="group-stock">
          <label>Stock inicial</label>
          <input id="stock" name="stock" type="number">
          <div class="form-error">Stock inválido</div>
        </div>

        <div class="form-group">
          <label>Activo</label>
          <select name="active">
            <option value="1">Sí</option>
            <option value="0">No</option>
          </select>
        </div>

        <div style="margin-top: 20px;">
          <button type="submit" class="btn">Guardar Producto</button>
          <a href="/productes" class="btn-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
</main>
{{> footer}}