<section>
  <h2>Afegir producte</h2>

  <form id="form-producte" method="POST" action="/create">
    <input type="hidden" name="taula" value="productes">

    <div class="form-group" data-field="name">
      <label>Nom *</label>
      <input type="text" name="name">
      <div class="form-error"></div>
    </div>

    <div class="form-group" data-field="category">
      <label>Categoria *</label>
      <input type="text" name="category">
      <div class="form-error"></div>
    </div>

    <div class="form-group" data-field="price">
      <label>Preu *</label>
      <input type="number" step="0.01" name="price">
      <div class="form-error"></div>
    </div>

    <div class="form-group" data-field="stock">
      <label>Stock *</label>
      <input type="number" name="stock">
      <div class="form-error"></div>
    </div>

    <div class="form-group" data-field="active">
      <label>Actiu</label>
      <select name="active">
        <option value="1">Sí</option>
        <option value="0">No</option>
      </select>
      <div class="form-error"></div>
    </div>

    <button class="btn">Guardar</button>
  </form>

  <script src="/js/productes-form.js"></script>
</section>
