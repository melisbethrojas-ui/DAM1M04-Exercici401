<h1>Agregar producto</h1>

<div class="card form-card">
  <form method="POST" action="/create" onsubmit="return validarProducto()">

    <input type="hidden" name="taula" value="products">

    <div class="form-group">
      <label>Nombre</label>
      <input id="name" name="name" type="text">
      <div class="form-error">El nombre es demasiado corto</div>
    </div>

    <div class="form-group">
      <label>Categoría</label>
      <input id="category" name="category" type="text">
    </div>

    <div class="form-group">
      <label>Precio</label>
      <input id="price" name="price" type="number" step="0.01">
      <div class="form-error">Precio inválido</div>
    </div>

    <div class="form-group">
      <label>Stock</label>
      <input id="stock" name="stock" type="number">
      <div class="form-error">Stock inválido</div>
    </div>

    <div class="form-group">
      <label>Activo</label>
      <select name="active">
        <option value="1">Sí</option>
        <option value="0">No</option>
      </select>
    </div>

    <button class="btn">Agregar</button>
  </form>
</div>
